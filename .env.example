# Spendly single-user authentication — copy this file to `.env.local`
# (which is gitignored) and fill in your own values. Never commit real
# secrets: `.env*` is ignored except for this template.
#
#   1. cp .env.example .env.local
#   2. Set SPENDLY_PASSWORD to the master password you want to use.
#   3. Generate a random session secret, e.g.:
#        node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#      and paste it as SPENDLY_SESSION_SECRET.

# The master password that unlocks the app (single user, stored in env only).
SPENDLY_PASSWORD=change-me

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Random secret used to HMAC-sign session cookies (32+ random bytes, hex or base64).
SPENDLY_SESSION_SECRET=replace-with-a-long-random-string
